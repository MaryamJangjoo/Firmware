; ============================================================
; secrets.ini.example
;
; Copy this file to secrets.ini and fill in the real values.
; secrets.ini is git-ignored and MUST NEVER be committed.
;
; Usage on Windows:
;   copy secrets.ini.example secrets.ini
;   notepad secrets.ini
;
; Usage on Linux/macOS:
;   cp secrets.ini.example secrets.ini
;   nano secrets.ini
; ============================================================

[secrets]
wifi_ssid = YOUR_WIFI_SSID
wifi_password = YOUR_WIFI_PASSWORD
api_base_url = http://192.168.1.100:3000
operator_username = YOUR_OPERATOR_USERNAME
operator_password = YOUR_OPERATOR_PASSWORD